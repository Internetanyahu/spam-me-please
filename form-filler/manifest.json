{
  "manifest_version": 3,
  "name": "Form Review Helper",
  "version": "1.0.0",
  "description": "User-controlled, one-form-at-a-time autofill. Never submits forms.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Form Review Helper", "default_popup": "popup.html"},
  "content_scripts": []
}